local shuffledQueue = {}
local function tpToRandom()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    if #shuffledQueue == 0 then
        local pool = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                table.insert(pool, p.Character)
            end
        end
        math.randomseed(tick())
        for i = #pool, 2, -1 do
            local j = math.random(1, i)
            pool[i], pool[j] = pool[j], pool[i]
        end
        shuffledQueue = pool
    end
    local nextTarget = table.remove(shuffledQueue, 1)
    if nextTarget and nextTarget:FindFirstChild("HumanoidRootPart") then
        task.defer(function() char.HumanoidRootPart.CFrame = nextTarget.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0) end)
    else shuffledQueue = {} end
end

