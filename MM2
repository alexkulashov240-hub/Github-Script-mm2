                            firetouchinterest(gun.Handle, mRoot, 0)
                            firetouchinterest(gun.Handle, mRoot, 1)
                        end
                    end
                end
                task.wait(0.2)
            end
            gunAuraBtn.Text = "Gun Aura (Авто-выстрел в мардера) [Биз: Нет]"
            gunAuraBtn.BackgroundColor3 = Color3.fromRGB(20, 24, 32)
        end)
    else
        gunAuraBtn.Text = "Gun Aura (Авто-выстрел в мардера) [Биз: Нет]"
        gunAuraBtn.BackgroundColor3 = Color3.fromRGB(20, 24, 32)
    end
end

