local function applyShader(profile)
    Lighting.GlobalShadows = true
    Lighting.Brightness = 2
    for _, eff in ipairs(Lighting:GetChildren()) do
        if eff:IsA("PostEffect") or eff:IsA("Sky") or eff:IsA("Atmosphere") then
            eff:Destroy()
        end
    end
    local atmosphere = Instance.new("Atmosphere") atmosphere.Density = 0.35 atmosphere.Parent = Lighting

    if profile == "Cyberpunk" then
        Lighting.ClockTime = 0.5
        Lighting.Brightness = 1.2
        Lighting.OutdoorAmbient = Color3.fromRGB(40, 20, 60)
        atmosphere.Color = Color3.fromRGB(120, 80, 200)
        local cc = Instance.new("ColorCorrectionEffect") cc.TintColor = Color3.fromRGB(200, 220, 255) cc.Contrast = 0.3 cc.Saturation = 0.4 cc.Parent = Lighting
        local bloom = Instance.new("BloomEffect") bloom.Intensity = 0.8 bloom.Size = 24 bloom.Parent = Lighting
    elseif profile == "Retro" then
        Lighting.ClockTime = 18
        Lighting.OutdoorAmbient = Color3.fromRGB(90, 40, 90)
        local cc = Instance.new("ColorCorrectionEffect") cc.TintColor = Color3.fromRGB(255, 180, 240) cc.Contrast = 0.4 cc.Saturation = 0.6 cc.Parent = Lighting
        local bloom = Instance.new("BloomEffect") bloom.Intensity = 1.2 bloom.Parent = Lighting
    elseif profile == "HDR" then
        Lighting.ClockTime = 14
        Lighting.Brightness = 2.5
        local cc = Instance.new("ColorCorrectionEffect") cc.Contrast = 0.25 cc.Saturation = 0.35 cc.Parent = Lighting
        local sun = Instance.new("SunRaysEffect") sun.Intensity = 0.25 sun.Parent = Lighting
    elseif profile == "Anime" then
        Lighting.ClockTime = 12
        Lighting.Brightness = 3
        local cc = Instance.new("ColorCorrectionEffect") cc.Saturation = 0.8 cc.Contrast = 0.3 cc.Parent = Lighting
    end
end

