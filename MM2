            elseif bindingAction == "AlwaysAnim" then alwaysAnimBtn.Text = "Эмоции [" .. nameStr .. "]"
            elseif bindingAction == "AutoGun" then autoGunBtn.Text = "Авто-Ган [" .. nameStr .. "]"
            elseif bindingAction == "KnifeAura" then auraBtn.Text = "Knife Aura [" .. nameStr .. "]"
            elseif bindingAction == "MassKill" then massKillBtn.Text = "Mass Kill [" .. nameStr .. "]"
            elseif bindingAction == "GunAura" then gunAuraBtn.Text = "Gun Aura [" .. nameStr .. "]"
