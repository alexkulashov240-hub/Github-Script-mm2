                toggleAimbotBtn.BackgroundColor3 = aimbotSettings.Enabled and Color3.fromRGB(35, 65, 45) or Color3.fromRGB(20, 24, 32)
            end
        end
    end
end)

local activeESP = {}
local function createESP(targetPlayer)
    if targetPlayer == player then return end
    local box = Drawing.new("Square") box.Visible = false box.Thickness = 1.5 box.Filled = false
    local tracer = Drawing.new("Line") tracer.Visible = false tracer.Thickness = 1
    local text = Drawing.new("Text") text.Visible = false text.Size = 13 text.Center = true text.Outline = true

    local highlight = Instance.new("Highlight")
    highlight.Name = "Lunix_Highlight"
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 0.6
    highlight.Enabled = false

    activeESP[targetPlayer] = {Box = box, Tracer = tracer, Text = text, Highlight = highlight}
    
    local connection
    connection = RunService.RenderStepped:Connect(function()
        local char = targetPlayer.Character
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        
        if not espSettings.Enabled or not char or not rootPart or not humanoid or humanoid.Health <= 0 then
            box.Visible = false tracer.Visible = false text.Visible = false highlight.Enabled = false
            return
        end
        
        if highlight.Parent ~= char then highlight.Parent = char end
        
        local backpack = targetPlayer:FindFirstChild("Backpack")
        local hasKnife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
        local hasGun = char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun"))
        
        local roleColor = Color3.fromRGB(0, 200, 0)
        if hasKnife then roleColor = Color3.fromRGB(220, 40, 40)
        elseif hasGun then roleColor = Color3.fromRGB(40, 100, 220) end
        
        if espSettings.Highlight then
            highlight.Enabled = true highlight.FillColor = roleColor highlight.OutlineColor = roleColor
        else highlight.Enabled = false end
        
        local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
        if onScreen then
            local head = char:FindFirstChild("Head")
            local topPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or vector
            local bottomPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
            local height = math.abs(topPos.Y - bottomPos.Y)
            local width = height / 2
            
            if espSettings.Boxes then
                box.Visible = true box.Size = Vector2.new(width, height) box.Position = Vector2.new(vector.X - width / 2, topPos.Y) box.Color = roleColor
            else box.Visible = false end
            
            -- Исправлено: espSettings.Tabs заменено на espSettings.Tracers
            if espSettings.Tracers then
                tracer.Visible = true tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y) tracer.To = Vector2.new(vector.X, bottomPos.Y) tracer.Color = roleColor
            else tracer.Visible = false end
            
            local displayText = ""
            if espSettings.Names then displayText = targetPlayer.Name end
            if espSettings.Distance and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local dist = math.floor((player.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude)
                displayText = displayText .. " [" .. dist .. "m]"
            end
            
            if (espSettings.Names or espSettings.Distance) and displayText ~= "" then
                text.Visible = true text.Text = displayText text.Position = Vector2.new(vector.X, topPos.Y - 16) text.Color = roleColor
            else text.Visible = false end
        else
            box.Visible = false tracer.Visible = false text.Visible = false
        end
    end)
    
    targetPlayer.Destroying:Connect(function()
        if connection then connection:Disconnect() end
        box:Remove() tracer:Remove() text:Remove() highlight:Destroy()
        activeESP[targetPlayer] = nil
    end)
end

